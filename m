 MAINTAINERS                                   |   1 +
 arch/arm/boot/dts/Makefile                    |   1 +
 arch/arm/boot/dts/bcm63148.dtsi               | 103 ++++++++++++++++++
 arch/arm/boot/dts/bcm963148.dts               |  30 +++++
 5 files changed, 142 insertions(+)
 create mode 100644 arch/arm/boot/dts/bcm63148.dtsi
