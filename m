 1 file changed, 7 insertions(+)

diff --git a/arch/arm/boot/dts/ep7209.dtsi b/arch/arm/boot/dts/ep7209.dtsi
index dacbe0d8e67a..02606547bdc5 100644
--- a/arch/arm/boot/dts/ep7209.dtsi
